---
import Areas from '../components/Areas.astro';
import Hero from '../components/Hero.astro';
import Instagram from '../components/Instagram.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Reviews from '../components/Reviews.astro';
import Base from '../layouts/Base.astro';
import { business } from '../lib/schema';
import { site } from '../lib/site';
---

<Base
  title={`Tømrer i ${site.city} – ${site.name}`}
  description={`${site.slogan}. Tømrerarbejde, flisearbejde og badeværelsesrenovering i ${site.city} og omegn. Få et uforpligtende tilbud.`}
  schema={{ '@context': 'https://schema.org', ...business }}
>
  <Hero />
  <QuoteForm />
  <Reviews />
  <Instagram />
  <Areas />
</Base>

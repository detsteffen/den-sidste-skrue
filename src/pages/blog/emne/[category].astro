---
import PageHead from '../../../components/PageHead.astro';
import PostCard from '../../../components/PostCard.astro';
import Base from '../../../layouts/Base.astro';
import { CATEGORIES, CATEGORY_IDS, type CategoryId } from '../../../lib/blog';
import { allPosts } from '../../../lib/posts';
import { absolute, breadcrumbs } from '../../../lib/schema';
import { site, url } from '../../../lib/site';

export const getStaticPaths = () =>
  CATEGORY_IDS.map((category) => ({ params: { category } }));

const id = Astro.params.category as CategoryId;
const category = CATEGORIES[id];
const posts = (await allPosts()).filter((post) => post.data.category === id);
const path = `blog/emne/${id}/`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: category.title,
      description: category.lead,
      url: absolute(path),
      inLanguage: 'da-DK',
      hasPart: posts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        url: absolute(`blog/${post.id}/`),
      })),
    },
    breadcrumbs([
      { path: 'blog/', name: 'Blog' },
      { path, name: category.name },
    ]),
  ],
};
---

<Base
  title={`${category.title} – ${site.name}`}
  description={category.lead}
  schema={schema}
>
  <section class="section section-top">
    <div class="wrap">
      <PageHead
        title={category.title}
        name={category.name}
        lead={category.lead}
        crumbs={[{ href: 'blog/', label: 'Blog' }]}
      >
        <nav class="jump" aria-label="Emner">
          {CATEGORY_IDS.map((other) => (
            <a href={url(`blog/emne/${other}/`)} aria-current={other === id ? 'page' : undefined}>{CATEGORIES[other].name}</a>
          ))}
          <a href={url('blog/ordbog/')}>Ordbog</a>
        </nav>
      </PageHead>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} level={2} />)}
      </div>
    </div>
  </section>
</Base>

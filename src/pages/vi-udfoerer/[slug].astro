---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import PageHead from '../../components/PageHead.astro';
import PostCard from '../../components/PostCard.astro';
import Screw from '../../components/Screw.astro';
import Base from '../../layouts/Base.astro';
import { allPosts, find } from '../../lib/posts';
import { absolute, breadcrumbs, business } from '../../lib/schema';
import { allServices, type Service } from '../../lib/services';
import { areas, photo, site, url } from '../../lib/site';

export async function getStaticPaths() {
  const services = await allServices();
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service, services },
  }));
}

interface Props {
  service: Service;
  services: Service[];
}

const { service, services } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const area = areas.find(({ id }) => id === data.area)!;
const areaName = area.title.replace('\u00ad', '');
const siblings = services.filter(
  (other) => other.data.area === data.area && other.id !== service.id,
);
const posts = await allPosts();
const guides = data.guides.map((id) => find(posts, id));
const path = `vi-udfoerer/${service.id}/`;
const name = data.title.replace('\u00ad', '');
const heading = data.heading.replace('\u00ad', '');

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    {
      '@type': 'Service',
      '@id': absolute(`${path}#ydelse`),
      name: heading,
      serviceType: name,
      description: data.description,
      url: absolute(path),
      provider: { '@id': business['@id'] },
      areaServed: { '@type': 'City', name: site.city },
    },
    breadcrumbs([
      { path: 'vi-udfoerer/', name: 'Vi udfører' },
      { path, name },
    ]),
    ...(data.faq.length
      ? [{
          '@type': 'FAQPage',
          mainEntity: data.faq.map(({ q, a }) => ({
            '@type': 'Question',
            name: q,
            acceptedAnswer: { '@type': 'Answer', text: a },
          })),
        }]
      : []),
  ],
};
---

<Base title={`${heading} – ${site.name}`} description={data.description} schema={schema}>
  <section class="section section-top">
    <div class="wrap service-hero">
      <PageHead
        title={data.heading}
        name={name}
        lead={data.lead}
        crumbs={[{ href: 'vi-udfoerer/', label: 'Vi udfører' }]}
      >
        <div class="actions" data-own-cta>
          <a class="button" href={url('#pris')}>Få et uforpligtende tilbud</a>
          <a class="button button-outline" href={`tel:${site.phoneHref}`}>Ring: {site.phone}</a>
        </div>
      </PageHead>
      <figure class="service-hero-photo" data-reveal>
        <Image
          src={photo(data.photo)}
          alt={data.photoAlt}
          width={880}
          height={1100}
          widths={[480, 880]}
          sizes="(max-width: 820px) 90vw, 420px"
          fit="cover"
          loading="eager"
        />
        {site.stockPhotos && <figcaption>Eksempelbillede</figcaption>}
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap service-layout">
      <aside class="service-aside">
        <div class="service-includes">
          <h2>Det kan vi hjælpe med</h2>
          <ul>
            {data.includes.map((item) => <li><Screw />{item}</li>)}
          </ul>
        </div>
        {siblings.length > 0 && (
          <nav class="service-siblings" aria-label={`Andet ${areaName.toLowerCase()}`}>
            <h2>Andet {areaName.toLowerCase()}</h2>
            <ul>
              {siblings.map((other) => (
                <li><a href={url(`vi-udfoerer/${other.id}/`)}>{other.data.title}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </aside>

      <div class="service-body">
        <div class="article-prose">
          <Content />
        </div>

        {data.faq.length > 0 && (
          <section class="faq" id="spoergsmaal">
            <h2>Ofte stillede spørgsmål</h2>
            {data.faq.map(({ q, a }) => (
              <div class="faq-item">
                <h3>{q}</h3>
                <p>{a}</p>
              </div>
            ))}
            {data.faq.some(({ a }) => a.includes(' kr.')) && (
              <p class="faq-note">Priserne er markedsestimater fra vores guides og ikke et tilbud.</p>
            )}
          </section>
        )}

        <aside class="article-cta">
          <h2>Har du en opgave til os?</h2>
          <p>Fortæl kort om opgaven, så vender vi tilbage med et uforpligtende tilbud.</p>
          <div class="actions" data-own-cta>
            <a class="button button-paper" href={url('#pris')}>Få et uforpligtende tilbud</a>
            <a class="button button-ghost" href={`tel:${site.phoneHref}`}>Ring: {site.phone}</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section-panel">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Guides til opgaven</h2>
        <a class="text-link" href={url('blog/')}>Alle guides</a>
      </div>
      <div class="post-grid">
        {guides.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</Base>

---
import { Image } from 'astro:assets';
import Offer from '../../components/Offer.astro';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { areas, photo, site, url } from '../../lib/site';
---

<Base
  title={`Vi udfører – ${site.name}`}
  description={`Tømrerarbejde, flisearbejde og badeværelsesrenovering i ${site.city} og omegn: vinduer og døre, tag, renovering, gulve, terrasser og fliser.`}
>
  <section class="section section-top">
    <div class="wrap">
      <PageHead title="Vi udfører" lead="Tømrerarbejde, flisearbejde og badeværelser. Find den opgave, der ligner din, og få et uforpligtende tilbud." />
    </div>
  </section>

  {areas.map((area, index) => (
    <section class:list={['section', 'area-section', { 'section-panel': index % 2 === 0 }]} id={area.id}>
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 class="section-title">{area.title}</h2>
            <p class="section-lead">{area.summary}</p>
          </div>
          <a class="button" href={url('#pris')}>Få et uforpligtende tilbud</a>
        </div>
        <ul class="jobs">
          {area.items.map((item) => (
            <li class="job">
              <Image src={photo(item.photo)} alt="" width={900} height={640} fit="cover" />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
        {site.stockPhotos && <p class="stock-note">Billederne er eksempler, indtil vi har vores egne klar.</p>}
      </div>
    </section>
  ))}
  <Offer />
</Base>

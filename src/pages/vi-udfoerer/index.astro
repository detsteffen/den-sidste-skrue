---
import { Image } from 'astro:assets';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { allPosts, find } from '../../lib/posts';
import { areas, photo, site, url } from '../../lib/site';

const posts = await allPosts();
---

<Base
  title={`Vi udfører – ${site.name}`}
  description={`Tømrerarbejde, flisearbejde og badeværelsesrenovering i ${site.city} og omegn: vinduer og døre, tag, renovering, gulve, terrasser og fliser.`}
>
  <section class="section section-top">
    <div class="wrap">
      <PageHead title="Vi udfører" lead="Tømrerarbejde, flisearbejde og badeværelser. Find den opgave, der ligner din, og få et uforpligtende tilbud.">
        <nav class="jump" aria-label="Områder">
          {areas.map((area) => <a href={`#${area.id}`}>{area.title}</a>)}
        </nav>
      </PageHead>
    </div>
  </section>

  {areas.map((area, index) => (
    <section class:list={['section', 'area-section', { 'section-panel': index % 2 === 0 }]} id={area.id}>
      <div class="wrap">
        <div class="section-head" data-reveal>
          <div>
            <h2 class="section-title">{area.title}</h2>
            <p class="section-lead">{area.summary}</p>
          </div>
          <a class="button button-outline" href={url('#pris')}>Få et uforpligtende tilbud</a>
        </div>
        <ul class="jobs" data-count={area.items.length}>
          {area.items.map((item, position) => (
            <li class="job" data-reveal style={`--i:${position % 3}`}>
              <div class="job-photo">
                <Image src={photo(item.photo)} alt="" width={1100} height={720} fit="cover" />
              </div>
              <div class="job-text">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <nav class="area-guides" aria-label={`Guides om ${area.title.replace('­', '').toLowerCase()}`}>
          <p class="eyebrow">Læs før du går i gang</p>
          <ul>
            {area.guides.map((id) => (
              <li><a class="text-link" href={url(`blog/${id}/`)}>{find(posts, id).data.title}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </section>
  ))}
</Base>

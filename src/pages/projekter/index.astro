---
import Offer from '../../components/Offer.astro';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { publishedProjects, site, url } from '../../lib/site';

const projects = await publishedProjects();
---

<Base
  title={`Projekter – ${site.name}`}
  description={`Se udvalgte opgaver fra ${site.name}: tømrer- og flisearbejde i ${site.city} og omegn.`}
>
  <section class="section section-top">
    <div class="wrap">
      <PageHead title="Projekter" lead="Udvalgte opgaver, med billeder før og efter og en kort beskrivelse af arbejdet." />

      {projects.length === 0 ? (
        <div class="empty">
          <h2>De første projekter er på vej</h2>
          <p>Vi samler billeder fra de opgaver, vi udfører, og viser dem her. I mellemtiden må du gerne ringe eller bede om en pris på dit eget projekt.</p>
          <div class="actions">
            <button type="button" class="button" data-open-quote>Få en pris</button>
            <a class="text-link" href={`tel:${site.phoneHref}`}>Ring {site.phone}</a>
          </div>
        </div>
      ) : (
        <div class="projects">
          {projects.map(({ id, data }) => (
            <a class="project" href={url(`projekter/${id}/`)}>
              <img src={url(`projekter/${id}/${data.cover}`)} alt="" loading="lazy" />
              <span class="project-name">{data.title}</span>
              <span class="project-meta">{data.task}, {data.place} {data.year}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  <Offer />
</Base>

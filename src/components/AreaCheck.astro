<form class="checker" id="checker" novalidate>
  <label class="field-label" for="checker-postcode">Dit postnummer</label>
  <div class="checker-row">
    <input id="checker-postcode" inputmode="numeric" autocomplete="postal-code" maxlength="4" placeholder="8000" />
    <button type="submit" class="button">Tjek</button>
  </div>
  <p class="checker-result" id="checker-result" role="status"></p>
  <button type="button" class="button" id="checker-quote" hidden>Få en pris</button>
</form>

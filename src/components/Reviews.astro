---
import reviews from '../data/reviews.json';

interface Review {
  text: string;
  name?: string;
  source?: string;
}

// Only real reviews go in src/data/reviews.json. The section stays off the
// page until there is at least one.
const list: Review[] = reviews;
---

{list.length > 0 && (
  <section class="section section-panel" id="anmeldelser">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title">Hvad synes vores kunder?</h2>
        <div class="carousel-buttons">
          <button type="button" data-carousel="-1" aria-label="Forrige anmeldelse">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <button type="button" data-carousel="1" aria-label="Næste anmeldelse">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>
      <ul class="reviews" id="reviews" tabindex="0" aria-label="Kundeanmeldelser">
        {list.map((review) => (
          <li class="review">
            <blockquote>{review.text}</blockquote>
            {review.name && <p class="review-name">{review.name}</p>}
            {review.source && <p class="review-source">{review.source}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

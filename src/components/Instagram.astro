---
import { latestPosts } from '../lib/instagram';
import { site, url } from '../lib/site';
import Screw from './Screw.astro';

const { url: profile } = site.instagram;
const posts = await latestPosts();
const emptyCells = (3 - (posts.length % 3)) % 3;
---

{profile && (
  <section class="section section-panel" id="instagram">
    <div class="wrap split">
      <div class="split-head" data-reveal>
        <h2 class="section-title">Følg med og se, hvad vi laver.</h2>
        <p class="section-lead">Se vores seneste projekter og følg med i hverdagen hos {site.name}.</p>
        <a class="button button-outline" href={profile} rel="noopener">Følg os på Instagram</a>
      </div>
      {posts.length > 0 ? (
        <ul class="insta" data-reveal>
          {posts.map((post) => (
            <li>
              <a href={post.link} rel="noopener">
                <img src={url(`instagram/${post.id}.webp`)} alt={post.alt} width={post.width} height={post.height} loading="lazy" />
              </a>
            </li>
          ))}
          {emptyCells > 0 && (
            <li class="insta-more" data-span={emptyCells}>
              <a href={profile} rel="noopener">
                <Screw />
                <span>Se flere på Instagram</span>
              </a>
            </li>
          )}
        </ul>
      ) : (
        <a class="insta-fallback" href={profile} rel="noopener" data-reveal>
          <Screw />
          <span>Vi lægger løbende billeder af vores arbejde på Instagram. Se dem dér.</span>
        </a>
      )}
    </div>
  </section>
)}

---
import { site, url } from '../lib/site';
---

<section class="offer">
  <div class="wrap offer-grid">
    <div>
      <h2>Har du et projekt i tankerne?</h2>
      <p>Fortæl os om det. Det er uforpligtende at spørge.</p>
    </div>
    <div class="actions">
      <a class="button button-paper" href={url('#pris')}>Få et uforpligtende tilbud</a>
      <a class="text-link" href={`tel:${site.phoneHref}`}>Ring: {site.phone}</a>
    </div>
  </div>
</section>

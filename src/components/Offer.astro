---
import { site } from '../lib/site';
---

<section class="offer" id="tilbud">
  <div class="wrap offer-grid">
    <div>
      <h2>Har du et projekt i tankerne?</h2>
      <p>Så lad os tage en snak. Vi hjælper dig gerne videre.</p>
    </div>
    <div class="actions">
      <button type="button" class="button button-paper" data-open-quote>Få en pris på dit projekt</button>
      <a class="text-link" href={`tel:${site.phoneHref}`}>Ring {site.phone}</a>
    </div>
  </div>
</section>

---
import { site, url } from '../lib/site';
import Screw from './Screw.astro';

const steps = [
  'Du fortæller os om dit projekt',
  'Vi gennemgår opgaven og finder den rigtige løsning',
  'Du modtager et tilbud',
];
---

<section class="section section-panel quote-section" id="pris">
  <div class="wrap quote">
    <div class="quote-copy" data-reveal>
      <h2 class="section-title">Få et uforpligtende tilbud</h2>
      <p class="section-lead">Fortæl kort om opgaven, så vender vi tilbage hurtigst muligt. Det tager et par minutter.</p>
      <ol class="steps">
        {steps.map((step, index) => (
          <li><span class="step-number">{index + 1}</span>{step}</li>
        ))}
      </ol>
      <a class="call-card" href={`tel:${site.phoneHref}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>
        <span>Vil du hellere ringe?<strong>{site.phone}</strong></span>
      </a>
    </div>

    <div class="quote-card" data-reveal data-own-cta>
      <form id="quote" data-endpoint={site.leadEndpoint} novalidate>
        <div class="field-row">
          <label class="field">
            <span class="field-label">Navn</span>
            <input name="name" autocomplete="name" required aria-describedby="name-error" />
            <span class="error" id="name-error" hidden>Skriv dit navn.</span>
          </label>
          <label class="field">
            <span class="field-label">Telefonnummer</span>
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="phone-error" />
            <span class="error" id="phone-error" hidden>Skriv et telefonnummer på mindst otte cifre.</span>
          </label>
        </div>

        <div class="field-row field-row-wide">
          <label class="field">
            <span class="field-label">E-mail</span>
            <input name="email" type="email" autocomplete="email" required aria-describedby="email-error" />
            <span class="error" id="email-error" hidden>Skriv en e-mailadresse, vi kan svare på.</span>
          </label>
          <label class="field">
            <span class="field-label">Postnummer</span>
            <input name="postcode" inputmode="numeric" autocomplete="postal-code" maxlength="4" required aria-describedby="postcode-error" />
            <span class="error" id="postcode-error" hidden>Skriv fire cifre.</span>
          </label>
        </div>

        <label class="field">
          <span class="field-label">Beskrivelse af arbejdet</span>
          <textarea name="details" rows="4" maxlength="2000" required aria-describedby="details-error" placeholder="Fx nye vinduer i stueetagen eller en træterrasse på ca. 30 m²"></textarea>
          <span class="error" id="details-error" hidden>Skriv et par ord om, hvad du gerne vil have lavet.</span>
        </label>

        <div class="field">
          <span class="field-label" id="files-label">Billeder <span class="optional">valgfrit</span></span>
          <label class="upload" id="dropzone">
            <input class="visually-hidden" type="file" id="files" multiple accept="image/jpeg,image/png,image/webp,image/heic,application/pdf" aria-labelledby="files-label" aria-describedby="files-note files-error" />
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V5m0 0-4 4m4-4 4 4M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path></svg>
            <span class="upload-title">Vedhæft billeder</span>
            <span class="upload-note" id="files-note"><span class="drag-hint">Træk dem herind, eller klik for at vælge. </span>Op til 8 filer på højst 10 MB hver.</span>
          </label>
          <ul class="files" id="file-list"></ul>
          <span class="error" id="files-error" role="alert" hidden></span>
        </div>

        <input class="visually-hidden" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <p class="error error-submit" id="submit-error" role="alert" hidden>Forespørgslen blev ikke sendt. Prøv igen, eller ring på {site.phone}.</p>
        <button type="submit" class="button button-wide">Send forespørgsel</button>
        <p class="fineprint">Vi bruger kun dine oplysninger til at svare på din henvendelse. <a href={url('privatliv/')}>Læs om privatliv</a>.</p>
      </form>

      <div class="quote-done" id="quote-done" tabindex="-1" hidden>
        <Screw />
        <h3>Forespørgsel modtaget</h3>
        <p id="done-text"></p>
        <p class="fineprint">Har du noget at tilføje, så ring på <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.</p>
      </div>
    </div>
  </div>
</section>

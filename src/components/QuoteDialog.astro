---
import { site, url, type Service } from '../lib/site';
import Screw from './Screw.astro';

interface Props {
  services: Service[];
}

const { services } = Astro.props;
const groups = [
  { id: 'ude', other: { task: 'Andet udvendigt', label: 'Noget andet udvendigt' } },
  { id: 'inde', other: { task: 'Andet indvendigt', label: 'Noget andet indvendigt' } },
] as const;
const questions = Object.fromEntries(
  services.map(({ data }) => [data.task, data.questions]),
);
---

<dialog class="sheet" id="quote-dialog" aria-label="Få en pris">
  <form id="quote" data-endpoint={site.leadEndpoint} novalidate>
    <aside class="sheet-side">
      <p class="brand"><Screw />{site.name}</p>
      <h2 class="sheet-title">Få en pris på dit projekt</h2>
      <dl class="summary">
        <div>
          <dt>Opgave</dt>
          <dd id="sum-task">Ikke valgt endnu</dd>
        </div>
        <div>
          <dt>Hvornår</dt>
          <dd id="sum-timing">Ikke valgt endnu</dd>
        </div>
        <div>
          <dt>Billeder</dt>
          <dd id="sum-files">Ingen endnu</dd>
        </div>
        <div>
          <dt>Område</dt>
          <dd id="sum-area">Ikke udfyldt endnu</dd>
        </div>
      </dl>
      <p class="sheet-call">Vil du hellere ringe? <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
    </aside>

    <div class="sheet-main">
      <div class="sheet-top">
        <div class="rail" id="rail" aria-hidden="true">
          <span class="rail-fill"></span>
          <Screw class="rail-screw" />
          <ol class="rail-stops">
            <li class="is-current">Opgave</li>
            <li>Detaljer</li>
            <li>Billeder</li>
            <li>Kontakt</li>
          </ol>
        </div>
        <button type="button" class="close" data-close aria-label="Luk">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
        </button>
      </div>
      <p class="visually-hidden" id="progress-label" aria-live="polite">Trin 1 af 4</p>

      <fieldset class="step" data-step="1">
        <legend tabindex="-1">Hvad skal du have lavet?</legend>
        <div class="segment segment-wide" role="group" aria-label="Hvor på huset">
          <button type="button" data-group-button="ude" aria-pressed="true">Udvendigt</button>
          <button type="button" data-group-button="inde" aria-pressed="false">Indvendigt</button>
        </div>
        {groups.map(({ id, other }) => (
          <div class="tasks" data-group={id} hidden={id !== 'ude'}>
            {services.filter(({ data }) => data.group === id).map(({ data }) => (
              <button type="button" class="task" data-pick={data.task}>{data.title}</button>
            ))}
            <button type="button" class="task" data-pick={other.task}>{other.label}</button>
          </div>
        ))}
        <input type="hidden" name="task" />
      </fieldset>

      <fieldset class="step" data-step="2" hidden>
        <legend tabindex="-1">Lidt om opgaven</legend>
        <div id="task-questions"></div>

        <div class="field" role="radiogroup" aria-labelledby="timing-label">
          <span class="field-label" id="timing-label">Hvornår skal det laves?</span>
          <div class="options">
            <label class="option"><input type="radio" name="timing" value="Hurtigst muligt" /><span>Hurtigst muligt</span></label>
            <label class="option"><input type="radio" name="timing" value="Inden for 3 måneder" /><span>Inden for 3 måneder</span></label>
            <label class="option"><input type="radio" name="timing" value="Senere" /><span>Senere</span></label>
            <label class="option"><input type="radio" name="timing" value="Ved ikke endnu" /><span>Ved ikke endnu</span></label>
          </div>
        </div>

        <div class="step-actions">
          <button type="button" class="back" data-back>Tilbage</button>
          <button type="button" class="button" data-next>Videre</button>
        </div>
      </fieldset>

      <fieldset class="step" data-step="3" hidden>
        <legend tabindex="-1">Beskrivelse og billeder</legend>

        <label class="field">
          <span class="field-label">Beskrivelse <span class="optional">valgfri</span></span>
          <textarea name="details" rows="3" maxlength="2000" placeholder="Fortæl med dine egne ord, hvad du gerne vil have lavet"></textarea>
        </label>

        <div class="field">
          <span class="field-label" id="files-label">Billeder eller tegninger <span class="optional">valgfri</span></span>
          <label class="upload">
            <input type="file" id="files" multiple accept="image/jpeg,image/png,image/webp,image/heic,application/pdf" aria-labelledby="files-label" aria-describedby="files-note files-error" />
            <span class="upload-title">Tilføj filer</span>
            <span class="upload-note" id="files-note">Op til 8 filer på højst 10 MB hver. JPG, PNG, WebP, HEIC eller PDF.</span>
          </label>
          <ul class="files" id="file-list"></ul>
          <span class="error" id="files-error" role="alert" hidden></span>
        </div>

        <div class="step-actions">
          <button type="button" class="back" data-back>Tilbage</button>
          <button type="button" class="button" data-next>Videre</button>
        </div>
      </fieldset>

      <fieldset class="step" data-step="4" hidden>
        <legend tabindex="-1">Hvor kan {site.owner.split(' ')[0]} få fat i dig?</legend>

        <label class="field">
          <span class="field-label">Navn</span>
          <input name="name" autocomplete="name" aria-describedby="name-error" />
          <span class="error" id="name-error" hidden>Skriv dit navn.</span>
        </label>

        <div class="field-row">
          <label class="field">
            <span class="field-label">Telefon</span>
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" aria-describedby="phone-error" />
            <span class="error" id="phone-error" hidden>Skriv et telefonnummer på mindst otte cifre.</span>
          </label>
          <label class="field">
            <span class="field-label">E-mail <span class="optional">valgfri</span></span>
            <input name="email" type="email" autocomplete="email" aria-describedby="email-error" />
            <span class="error" id="email-error" hidden>E-mailadressen ser ikke rigtig ud. Ret den, eller lad feltet stå tomt.</span>
          </label>
        </div>

        <div class="field-row field-row-address">
          <label class="field">
            <span class="field-label">Adresse på opgaven <span class="optional">valgfri</span></span>
            <input name="address" autocomplete="street-address" />
          </label>
          <label class="field">
            <span class="field-label">Postnummer</span>
            <input name="postcode" inputmode="numeric" autocomplete="postal-code" maxlength="4" aria-describedby="postcode-error postcode-hint" />
          </label>
        </div>
        <span class="hint" id="postcode-hint"></span>
        <span class="error" id="postcode-error" hidden>Skriv et postnummer på fire cifre.</span>

        <input class="visually-hidden" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <p class="error error-submit" id="submit-error" role="alert" hidden>Forespørgslen blev ikke sendt. Prøv igen, eller ring på {site.phone}.</p>

        <div class="step-actions">
          <button type="button" class="back" data-back>Tilbage</button>
          <button type="submit" class="button">Send forespørgsel</button>
        </div>
        <p class="fineprint">Vi bruger kun dine oplysninger til at kontakte dig om opgaven. Læs mere under <a href={url('privatliv/')}>privatliv</a>.</p>
      </fieldset>

      <div class="step step-done" data-step="5" hidden>
        <Screw class="done-screw" />
        <h3 tabindex="-1">Forespørgsel sendt</h3>
        <p id="done-text"></p>
        <div class="step-actions">
          <button type="button" class="button" data-close>Luk</button>
        </div>
      </div>
    </div>
  </form>
  <script is:inline type="application/json" id="quote-questions" set:html={JSON.stringify(questions)} />
</dialog>

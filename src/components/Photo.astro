---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../lib/site';

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  class?: string;
}

const { src, alt, width, height, class: name } = Astro.props;
---

<figure class:list={['photo', name]}>
  <Image src={src} alt={alt} width={width} height={height} fit="cover" />
  {site.stockPhotos && <figcaption>Eksempelbillede</figcaption>}
</figure>

---
import Rings from '../components/Rings.astro';
import Screw from '../components/Screw.astro';
import { site, url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Structured data for search engines, as a schema.org object. */
  schema?: Record<string, unknown>;
  /** Full address of the picture shown when the page is shared. */
  image?: string;
  /** Dates for a blog post, which also marks the page as an article. */
  article?: { published: Date; updated: Date };
}

const { title, description, schema, image, article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: 'om-os/', label: 'Om os' },
  { href: 'vi-udfoerer/', label: 'Vi udfører' },
];
const mark =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='50' fill='%23B8892F'/%3E%3Cpath d='M50 19 59.5 33.55 76.85 34.5 69 50 76.85 65.5 59.5 66.45 50 81 40.5 66.45 23.15 65.5 31 50 23.15 34.5 40.5 33.55z' fill='%23F6F1E4' stroke='%23F6F1E4' stroke-width='7' stroke-linejoin='round'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!site.indexable && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F6F1E4" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:modified_time" content={article.updated.toISOString()} />}
    <link rel="icon" href={mark} />
    <link rel="alternate" type="application/rss+xml" title={`Råd og guides fra ${site.name}`} href={url('blog/rss.xml')} />
    <link rel="preload" href={url('fonts/fraunces-latin-wght-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('fonts/inter-latin-wght-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={url('styles.css')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <svg class="sprite" aria-hidden="true">
      <symbol id="screw" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="50" fill="currentColor"></circle>
        <path class="screw-star" d="M50 19 59.5 33.55 76.85 34.5 69 50 76.85 65.5 59.5 66.45 50 81 40.5 66.45 23.15 65.5 31 50 23.15 34.5 40.5 33.55z"></path>
      </symbol>
      <symbol id="ig" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="3" width="18" height="18" rx="5.5"></rect>
        <circle cx="12" cy="12" r="4.2"></circle>
        <circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"></circle>
      </symbol>
    </svg>
    <div class="top-sentinel" id="top-sentinel"></div>

    <header class="header">
      <div class="wrap header-row">
        <a class="brand" href={url()} aria-label={`${site.name}, til forsiden`}><Screw />{site.name}</a>
        <nav class="nav" id="site-nav" aria-label="Sider">
          {nav.map(({ href, label }) => (
            <a class="nav-link" href={url(href)} aria-current={Astro.url.pathname.startsWith(url(href)) ? 'page' : undefined}>{label}</a>
          ))}
          <div class="nav-extra">
            <a class="button" href={url('#pris')}>Få et uforpligtende tilbud</a>
            <a class="button button-outline" href={`tel:${site.phoneHref}`}>Ring: {site.phone}</a>
          </div>
        </nav>
        {site.instagram.url && (
          <a class="header-icon" href={site.instagram.url} rel="noopener" aria-label="Følg os på Instagram">
            <svg class="ig" aria-hidden="true"><use href="#ig"></use></svg>
          </a>
        )}
        <a class="header-phone" href={`tel:${site.phoneHref}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"></path></svg>
          Ring: {site.phone}
        </a>
        <a class="button button-small" href={url('#pris')}>Få en pris</a>
        <button type="button" class="menu-button" aria-expanded="false" aria-controls="site-nav">
          <span class="visually-hidden">Menu</span>
          <span class="menu-icon" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="closing" data-reveal>
          <Rings />
          <p class="closing-line">Vi går først, når den sidste skrue er <span class="nowrap">sat<Screw class="period" /></span></p>
          <div class="actions" data-own-cta>
            <a class="button button-paper" href={url('#pris')}>Få et uforpligtende tilbud</a>
            <a class="button button-ghost" href={`tel:${site.phoneHref}`}>Ring: {site.phone}</a>
          </div>
        </div>

        <div class="footer-cols">
          <div class="footer-brand">
            <p class="brand"><Screw />{site.name}</p>
            <p>{site.slogan}.</p>
          </div>
          <div>
            <h2>Kontakt</h2>
            <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
          <div>
            <h2>Sider</h2>
            <ul>
              <li><a href={url()}>Forside</a></li>
              {nav.map(({ href, label }) => <li><a href={url(href)}>{label}</a></li>)}
              <li><a href={url('blog/')}>Råd og guides</a></li>
              <li><a href={url('privatliv/')}>Privatliv</a></li>
            </ul>
          </div>
          <div>
            <h2>Firma</h2>
            <p>v/ {site.owner}</p>
            <p>CVR {site.cvr}</p>
            <p>{site.trade} i {site.city} og omegn</p>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© 2026 {site.name}</p>
          {site.stockPhotos && <p>Billederne på siden er eksempler, indtil vi har vores egne klar.</p>}
        </div>
      </div>
    </footer>

    <div class="mobile-bar">
      <a class="button button-outline" href={`tel:${site.phoneHref}`}>Ring</a>
      <a class="button" href={url('#pris')}>Få en pris</a>
    </div>

    <script is:inline src={url('app.js')}></script>
  </body>
</html>

# Every three hours, rebuilds the site if the Instagram feed has new posts.
# deploy.sh installs this as /etc/cron.d/den-sidste-skrue; the output goes
# to the journal: journalctl -t den-sidste-skrue
17 */3 * * * root flock -n /run/den-sidste-skrue-refresh.lock /opt/den-sidste-skrue/deploy/hetzner/refresh-instagram.sh 2>&1 | logger -t den-sidste-skrue
